--cpu Cortex-M3
"hw3.3\startup_stm32f103xb.o"
"hw3.3\main.o"
"hw3.3\gpio.o"
"hw3.3\tim.o"
"hw3.3\stm32f1xx_it.o"
"hw3.3\stm32f1xx_hal_msp.o"
"hw3.3\stm32f1xx_hal_gpio_ex.o"
